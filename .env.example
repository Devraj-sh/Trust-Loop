# TrustLoop 2.0 Environment Configuration
# When SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are not connected to a live cloud instance,
# TrustLoop automatically runs in Resilient Local Offline Mode backed by pre-seeded Indian
# e-commerce benchmark dataset orders and in-memory mock-store.

SUPABASE_URL=https://offline-demo.supabase.co
SUPABASE_PUBLISHABLE_KEY=offline_demo_publishable_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=offline_demo_service_role_key_placeholder

VITE_SUPABASE_URL=https://offline-demo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=offline_demo_publishable_key_placeholder

# Optional: Google Gemini API Key for AI visual evidence analysis
# If not provided, TrustLoop uses explainable deterministic heuristic vision fallback.
# GEMINI_API_KEY=
